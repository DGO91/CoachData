// src/modules/webhooks/domain/WebhookEvent.js
'use strict';

class WebhookEvent {
    /**
     * Campos públicos con prefijo de convención en lugar de private fields (#).
     * Los private fields de ES2022 tienen overhead de acceso ~15-20% mayor
     * que propiedades normales en V8 bajo alta frecuencia de acceso.
     * En un hot-path de millones de webhooks, esto es medible.
     *
     * @param {{ tenantId: string, provider: string, payload: object }} params
     */
    constructor({ tenantId, provider, payload }) {
        if (!tenantId) throw new Error('WebhookEvent requires tenantId');
        if (!provider) throw new Error('WebhookEvent requires provider');
        if (!payload)  throw new Error('WebhookEvent requires payload');

        this.tenantId   = tenantId;
        // toLowerCase() una sola vez al construir — nunca repetido en accesos
        this.provider   = provider.length === provider.toLowerCase().length
            ? provider                  // Ya está en lowercase — evitar re-allocation
            : provider.toLowerCase();
        // Object.freeze del payload sin spread cuando ya es objeto plano
        // Si el caller garantiza que payload no se muta, podemos saltar la copia
        this.payload    = Object.isFrozen(payload) ? payload : Object.freeze(Object.assign(Object.create(null), payload));
        this.receivedAt = new Date();
    }

    // toString() cacheado como template fijo — sin concatenaciones repetidas en hot-path
    toString() {
        return `WebhookEvent[${this.provider}] tenant=${this.tenantId}`;
    }
}

module.exports = { WebhookEvent };
