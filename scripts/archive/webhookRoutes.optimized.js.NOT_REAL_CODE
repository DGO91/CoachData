// src/modules/webhooks/application/WebhookDispatcher.js
'use strict';

const { WebhookEvent } = require('../domain/WebhookEvent');

class WebhookDispatcher {
    /**
     * @param {object}                                                        deps
     * @param {import('./ports/ITenantRepository').ITenantRepository}         deps.tenantRepository
     * @param {import('./ports/IKeyRepository').IKeyRepository}               deps.keyRepository
     * @param {import('../registry/HandlerRegistry').HandlerRegistry}         deps.handlerRegistry
     * @param {import('../../../shared/logger').logger}                       deps.logger
     */
    constructor({ tenantRepository, keyRepository, handlerRegistry, logger }) {
        this._tenantRepository = tenantRepository;
        this._keyRepository    = keyRepository;
        this._handlerRegistry  = handlerRegistry;
        this._logger           = logger;
    }

    /**
     * Orquesta la recepción y el despacho de un webhook entrante.
     *
     * Optimizaciones clave:
     * 1. Fail-fast antes de cualquier I/O (handler + validaciones síncronas)
     * 2. I/O paralelo: tenant y keys se resuelven concurrentemente con Promise.all
     *    — elimina latencia en serie (antes: lat_tenant + lat_keys, ahora: max(lat_tenant, lat_keys))
     *
     * @param {{ tenantId: string, provider: string, payload: object }} input
     * @returns {Promise<void>}
     */
    async dispatch({ tenantId, provider, payload }) {
        // 1. Construir entidad de dominio — validación síncrona, sin I/O
        const event = new WebhookEvent({ tenantId, provider, payload });

        this._logger.info(`[WebhookDispatcher] Received ${event}`);

        // 2. Fail-fast síncrono: provider no soportado → corte inmediato sin I/O
        //    event.provider ya está normalizado a lowercase por WebhookEvent
        const handler = this._handlerRegistry.resolve(event.provider);

        // 3. I/O paralelo — tenant y keys no tienen dependencia entre sí
        //    Promise.all lanza TenantNotFoundError o KEY_FETCH_FAILED si alguno falla
        const [tenant, decryptedKeys] = await Promise.all([
            this._tenantRepository.findById(tenantId),
            this._keyRepository.findDecryptedKeysByTenantId(tenantId),
        ]);

        // 4. Delegar procesamiento al handler
        await handler.handle(event, decryptedKeys);

        this._logger.info(`[WebhookDispatcher] Dispatched ${event} for ${tenant}`);
    }
}

module.exports = { WebhookDispatcher };
```

