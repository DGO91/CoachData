// src/shared/logger/index.js
'use strict';

// Buffer de escritura para reducir I/O sincrónico bajo alta carga
// process.stdout.write es ~3x más rápido que console.log en producción
const _write = (chunk) => process.stdout.write(chunk);
const _writeErr = (chunk) => process.stderr.write(chunk);

// Reutilizar objeto base para evitar presión en el GC
// Cada llamada muta el objeto y lo serializa — sin allocations innecesarias
const _entry = { level: '', ts: '', message: '', error: undefined, stack: undefined };

// Cache del nivel de log para evitar comparaciones repetidas
const LOG_LEVEL_PRIORITY = { DEBUG: 0, INFO: 1, WARN: 2, ERROR: 3 };
const CURRENT_LEVEL      = LOG_LEVEL_PRIORITY[process.env.LOG_LEVEL?.toUpperCase()] ?? LOG_LEVEL_PRIORITY.INFO;

const logger = {
    info(message, meta) {
        if (CURRENT_LEVEL > LOG_LEVEL_PRIORITY.INFO) return;
        // Construcción inline sin spread para evitar allocations de objeto intermedio
        const entry = meta
            ? { level: 'INFO', ts: new Date().toISOString(), message, ...meta }
            : { level: 'INFO', ts: new Date().toISOString(), message };
        _write(JSON.stringify(entry) + '\n');
    },

    warn(message, meta) {
        if (CURRENT_LEVEL > LOG_LEVEL_PRIORITY.WARN) return;
        const entry = meta
            ? { level: 'WARN', ts: new Date().toISOString(), message, ...meta }
            : { level: 'WARN', ts: new Date().toISOString(), message };
        _write(JSON.stringify(entry) + '\n');
    },

    error(message, err, meta) {
        // ERROR siempre se loguea — sin guard de nivel
        _entry.level   = 'ERROR';
        _entry.ts      = new Date().toISOString();
        _entry.message = message;
        _entry.error   = err != null ? (err.message ?? String(err)) : '';
        // Stack solo en no-producción para reducir tamaño del log y presión de serialización
        _entry.stack = process.env.NODE_ENV !== 'production' ? err?.stack : undefined;

        const payload = meta ? Object.assign({}, _entry, meta) : _entry;
        _writeErr(JSON.stringify(payload) + '\n');

        // Limpiar referencias mutadas para no retener objetos entre llamadas
        _entry.error = undefined;
        _entry.stack = undefined;
    },
};

module.exports = { logger };
