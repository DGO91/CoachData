const express = require('express');
const { 
    syncAndGetTenants, 
    createTenant, 
    updateTenantPackage 
} = require('../../../application/tenant/tenantUseCase');

const router = express.Router();

router.get('/admin/tenants', async (req, res) => {
    try {
        const tenants = await syncAndGetTenants();
        res.json(tenants);
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

router.post('/admin/tenants', async (req, res) => {
    try {
        const tenant = await createTenant(req.body);
        res.json(tenant);
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

router.put('/admin/tenants/:id', async (req, res) => {
    try {
        const tenant = await updateTenantPackage(req.params.id, req.body.active_package);
        res.json(tenant);
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});

module.exports = router;
